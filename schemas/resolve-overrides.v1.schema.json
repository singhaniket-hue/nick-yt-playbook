{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rabbithole.local/schemas/resolve-overrides.v1.schema.json",
  "title": "Resolve compiler overrides",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "media_root": {"type": "string", "minLength": 1},
    "asset_paths": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "clip_tracks": {
      "type": "object",
      "additionalProperties": {"enum": ["V1", "V2"]}
    },
    "transforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scale": {
            "oneOf": [
              {"type": "number"},
              {
                "type": "array",
                "prefixItems": [{"type": "number"}, {"type": "number"}],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "position": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          },
          "x": {"type": "number"},
          "y": {"type": "number"},
          "rotation": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "review_resolutions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {
            "type": "object",
            "required": ["resolved"],
            "properties": {
              "resolved": {"type": "boolean"},
              "note": {"type": "string"}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
